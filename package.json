{
  "name": "psyclaw",
  "version": "0.29.10",
  "description": "A standalone, evidence-grounded social-science research agent with research contracts, evidence gates, and recoverable workflows",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Exekiel179/psyclaw.git"
  },
  "homepage": "https://github.com/Exekiel179/psyclaw#readme",
  "bugs": {
    "url": "https://github.com/Exekiel179/psyclaw/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "bin": {
    "psyclaw": "scripts/psyclaw.mjs"
  },
  "files": [
    "dist/src",
    "dist/apps/panel/index.html",
    "skills",
    "agents",
    "vendor/ars",
    "vendor/nature-skills",
    "vendor/academic-paper-skills",
    "vendor/windows",
    "scripts/psyclaw.mjs",
    "scripts/rebrand-pi.mjs"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "ai",
    "agent",
    "research",
    "social-science",
    "evidence",
    "pi"
  ],
  "packageManager": "pnpm@10.28.2",
  "pi": {
    "extensions": [
      "./dist/src/extension.js",
      "./dist/src/panel/extension.js",
      "./vendor/ars/pi/wrapper.js"
    ],
    "skills": [
      "./skills/core",
      "./skills/scholars",
      "./vendor/ars/deep-research",
      "./vendor/ars/academic-paper",
      "./vendor/ars/academic-paper-reviewer",
      "./vendor/ars/academic-pipeline",
      "./vendor/nature-skills/skills/nature-figure",
      "./vendor/nature-skills/skills/nature-ref-verifier",
      "./vendor/nature-skills/skills/nature-polishing",
      "./vendor/academic-paper-skills/academic-paper-strategist",
      "./vendor/academic-paper-skills/academic-paper-composer"
    ],
    "prompts": [
      "./vendor/ars/commands"
    ]
  },
  "scripts": {
    "build": "node scripts/rebrand-pi.mjs && tsc -p tsconfig.json && node scripts/copy-panel.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:ars": "vitest run tests/unit/bundled-ars.test.ts tests/unit/bundled-nature-compose.test.ts tests/unit/ars-profile.test.ts tests/unit/ars-mode-editor.test.ts tests/unit/ars-panel-plan.test.ts tests/unit/ars-bridge.test.ts",
    "test:watch": "vitest",
    "eval": "tsx evals/harness.ts",
    "eval:modules": "tsx evals/modules.ts",
    "eval:academic-route": "tsx evals/academic-soft-route/harness.ts",
    "rebrand": "node scripts/rebrand-pi.mjs",
    "check:branding": "node scripts/check-branding.mjs",
    "release:push": "node scripts/release-push.mjs",
    "prepublishOnly": "pnpm check:branding && pnpm build"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "typebox": "1.3.7",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "@types/react": "^19.2.18",
    "tsx": "4.20.3",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
