# Langfuse Relay Environment Variables
# Copy this file to .env and fill in your values

# Required: Langfuse project credentials
LANGFUSE_PUBLIC_KEY=pk_lf_...
LANGFUSE_SECRET_KEY=sk_lf_...

# Optional: Langfuse host (default: https://cloud.langfuse.com)
LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: Server port (default: 3000)
PORT=3000

# Optional: CORS allowed origins (default: *)
# Example: https://app.example.com,https://staging.example.com
ALLOWED_ORIGINS=*
