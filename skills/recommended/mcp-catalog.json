  "items": [
    {
      "id": "computer-use-mcp",
      "name": "Computer Use MCP",
      "stage": "电脑操控",
      "description": "本机桌面控制（Windows / macOS / Linux）：截图、键鼠、剪贴板、窗口与应用管理。高风险副作用；默认 discover-only，执行须显式授权。macOS 无 API 原生应用也可另装 Mac Computer Use Skill。",
      "sourceRef": "https://github.com/zavora-ai/computer-use-mcp",
      "transport": "stdio",
      "risk": "desktop-control",
      "writeEffects": true,
      "status": "discover-only"
    },
    {
      "id": "markitdown-mcp",
