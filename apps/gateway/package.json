{
  "name": "@psyclaw/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "PsyClaw official gateway service with WeChat Pay and Alipay integration",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fastify": "^5.2.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^10.1.1",
    "pg": "^8.13.1",
    "ioredis": "^5.4.2",
    "jose": "^6.2.12"
  },
  "devDependencies": {
    "@types/node": "^24.12.4",
    "@types/pg": "^8.11.10",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
