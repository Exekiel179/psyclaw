# 服务端口
PORT=3000
NODE_ENV=development

# 数据库
DATABASE_URL=postgresql://user:pass@localhost:5432/psyclaw_gateway
REDIS_URL=redis://localhost:6379

# 上游 Provider 凭据（从环境变量读取，不提交到仓库）
UPSTREAM_DEEPSEEK_API_KEY=sk-xxx
UPSTREAM_ANTHROPIC_API_KEY=sk-ant-xxx

# 微信支付配置（官方文档：https://pay.weixin.qq.com/wiki/doc/apiv3/index.shtml）
WECHAT_PAY_MCH_ID=1234567890
WECHAT_PAY_API_KEY=your-api-v3-key-32-chars-min
WECHAT_PAY_CERT_SERIAL=cert-serial-number
WECHAT_PAY_PRIVATE_KEY_PATH=/path/to/apiclient_key.pem
WECHAT_PAY_NOTIFY_URL=https://api.psyclaw.ai/webhooks/wechat

# 支付宝配置（官方文档：https://opendocs.alipay.com/open/270/105898）
ALIPAY_APP_ID=2021001234567890
ALIPAY_PRIVATE_KEY=MIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC...
ALIPAY_PUBLIC_KEY=MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAl...
ALIPAY_NOTIFY_URL=https://api.psyclaw.ai/webhooks/alipay
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# Stripe 配置（次要，可选）
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# JWT 签名密钥（至少 32 字符，用于生成访问 token）
JWT_SECRET=your-random-secret-at-least-32-characters-long

# 网关公网地址
GATEWAY_BASE_URL=https://api.psyclaw.ai

# 可选：国内节点地址（用于客户端配置）
# GATEWAY_CHINA_NODE=https://api-cn.psyclaw.ai

# 可选：日志级别
LOG_LEVEL=info
