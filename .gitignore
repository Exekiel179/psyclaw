node_modules/
dist/
.psyclaw/
coverage/
*.local.json
__pycache__/
*.py[cod]
.pytest_cache/

# Credentials and local overrides must never enter version control.
.env
.env.*
*.key
*.pem
*credentials*
*secret*
.claude/CLAUDE.local.md
.claude/settings.local.json

# Versioned eval reports: keep the current baseline, ignore timestamped runs.
evals/reports/*.json
!evals/reports/latest.json
!evals/reports/modules-latest.json

# psyclaw runtime artifacts created when psyclaw runs inside its own repo dir.
artifacts/
logs/
notes/
outputs/
panel-*.png
psyclaw-session-*.html
.tmp-*
