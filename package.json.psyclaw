{
  "schemaVersion": "psyclaw/package-governance/v1",
  "id": "psyclaw",
  "apiVersion": "0.29",
  "capabilities": ["evidence-ledger", "integrity-gates", "session-modes", "soft-verify"],
  "permissions": {
    "read": ["project-root"],
    "write": [".psyclaw", "notes", "outputs", "data/clean", "analysis", "paper", "literature"],
    "network": "disabled-by-default",
    "destructive": "denied-by-default"
  },
  "trust": "builtin",
  "license": {
    "spdx": "MIT",
    "evidenceRef": "LICENSE"
  },
  "source": {
    "kind": "workspace",
    "ref": "psypi@e3786ab753b3c4fee0997f12e781d3186c9c668d"
  }
}
