# Telemetry (default on, easy opt-out)

PsyClaw sends **anonymous product telemetry by default** so the tool can be
improved. Research text stays on the machine. Turn it off at any time.

# Force this process off (CI / local debugging)
# PSYCLAW_TELEMETRY=0

# Optional: override the bundled public client credentials
# Node / CLI agent — Sentry project slug: psyclaw
# SENTRY_DSN=
# Browser panel — Sentry project slug: psyclaw-web
# SENTRY_DSN_WEB=
# PUBLIC_SENTRY_DSN=
# POSTHOG_KEY=
# PUBLIC_POSTHOG_KEY=
# POSTHOG_HOST=
# PUBLIC_POSTHOG_HOST=
# SENTRY_RELEASE=
# SENTRY_ENVIRONMENT=

# Optional Langfuse Cloud (no-op when unset). Free-tier: https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=
# LANGFUSE_BASE_URL=

# Debug: override the CLI/panel PostHog distinct_id for this process only
# PSYCLAW_DISTINCT_ID=
